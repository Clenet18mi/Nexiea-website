# URL du webhook du CRM (Zapier, Make, n8n, HubSpot, Pipedrive...). Obligatoire en production, https uniquement.
CRM_WEBHOOK_URL=https://example.com/hook
# Secret partagé pour signer chaque envoi (en-tête X-Nexiea-Signature, HMAC-SHA256 hex du corps).
CRM_WEBHOOK_SECRET=changez-moi
# Origines autorisées à appeler /api/lead (obligatoire en production).
ALLOWED_ORIGINS=https://nexiea.fr,https://www.nexiea.fr
